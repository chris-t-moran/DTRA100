---
// Home: the map app (public/main.js) plus sharing previews and a plain list of
// story links for search engines and visitors without JavaScript.
import { loadSiteData, LOGO } from '../lib/data.js';
const { articles, slugs } = await loadSiteData();
const url = new URL('/', Astro.site).href;
const description = 'A celebration of one of Ireland\'s first social housing estates: stories, first residents of 1929 and walking tours of the Drumcondra Triangle, Dublin.';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Triangle100 – A celebration of community</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta property="og:site_name" content="Triangle100" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Triangle100 – A celebration of community" />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={LOGO} />
  <meta property="og:locale" content="en_IE" />
  <meta name="twitter:card" content="summary" />
  <meta name="theme-color" content="#1F6B43" />
  <!-- Fonts: Fraunces (headings, story text) + Inter (interface) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600&family=Inter:wght@400;500;600&display=swap" />
  <!-- Global styles for the site -->
  <link rel="stylesheet" href="/styles.css" />
  <!-- Leaflet CSS & marker cluster CSS -->
  <!-- Versions pinned: Leaflet 2.0 is not compatible with this code -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha384-sHL9NAb7lN7rfvG5lfHpm643Xkcjzp4jFvuavGOndn6pjVqS6ny56CAt3nsEVT4H" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css"
    integrity="sha384-pmjIAcz2bAn0xukfxADbZIb3t8oRT9Sv0rvO+BR5Csr6Dhqq+nZs59P0pPKQJkEV" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css"
    integrity="sha384-wgw+aLYNQ7dlhK47ZPK7FRACiq7ROZwgFNg0m04avm4CaXS+Z9Y7nMu8yNjBKYC+" crossorigin="anonymous" />
  <!-- Leaflet Routing Machine CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css"
    integrity="sha384-n6BdBD4Ahcb9IGZDgjgv0hV2a/y2WOCf1n0kEMZDpZySy/Hv1QMAtLIrC3y9oIZD" crossorigin="anonymous" />
  <!-- Favicon for the site -->
  <link
    rel="icon"
    type="image/png"
    href="https://vqkoapgiozhytoqscxxx.supabase.co/storage/v1/object/public/icons/T100_icon/T100_transparent_cropped_logo.PNG"
  />
</head>
<body>
  <a class="skip-link" href="#content">Skip to stories</a>
  <div id="mainpage">
    <!-- Map fills the screen; everything else sits over it -->
    <section id="map" aria-label="Interactive map"></section>

    <!-- Top bar: brand + Today/1929 switch -->
    <header id="topbar">
      <a id="brand" href="./" aria-label="Triangle100 home">
        <img src="https://vqkoapgiozhytoqscxxx.supabase.co/storage/v1/object/public/icons/T100_icon/T100_transparent_cropped_logo.PNG"
             alt="" width="36" height="36" />
        <span>Triangle100</span>
      </a>
      <div id="era-toggle" class="segmented" role="group" aria-label="Map era">
        <button type="button" data-era="today" aria-pressed="true">Today</button>
        <button type="button" data-era="1929" aria-pressed="false">1929</button>
      </div>
    </header>

    <!-- The panel: slides up on phones, sits beside the map on larger screens -->
    <section id="content" aria-label="Stories">
      <div id="content-handle" class="content-handle" aria-hidden="true"></div>
      <header id="panel-header">
        <h1 id="panel-title">Stories from the Triangle</h1>
        <p id="panel-count" class="panel-count"></p>
      </header>

      <!-- Today: search, filters and story list -->
      <div id="era-today-panel">
        <nav id="themes" aria-label="Story categories"></nav>
        <section id="intro" class="panel-card"></section>
        <section id="article-list" aria-live="polite"></section>
      </div>

      <!-- 1929: first residents tools -->
      <div id="era-1929-panel" hidden>
        <p class="panel-lede">The Drumcondra scheme's first families got their keys in 1929. Tap a house on the map, or look up your own.</p>
        <div class="panel-actions">
          <button type="button" id="btn-house" class="btn btn-primary">Who first lived in my house?</button>
          <button type="button" id="btn-numbers" class="btn btn-secondary">1929 in numbers</button>
        </div>
        <label class="field">
          <span>Search the 1929 map by address or name</span>
          <input id="resident-search" type="search" placeholder="e.g. Hardiman Road or Sexton" autocomplete="off" />
        </label>
        <p class="panel-hint"><span class="legend-dot legend-moved" aria-hidden="true"></span> Glowing houses: tap to see where that family moved from.</p>
      </div>

      <button id="share-story-btn" class="btn btn-share" type="button">Share your story</button>
      <a class="panel-link" href="/stories/">Browse all stories as a list</a>
      <section id="about-project" class="panel-card"></section>
    </section>

    <!-- Bottom tabs (phones) / panel tabs (larger screens) -->
    <nav id="tabbar" aria-label="Main">
      <button type="button" data-tab="explore" aria-current="page">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z"/><path d="M9 4v14M15 6v14"/></svg>
        <span>Explore</span>
      </button>
      <button type="button" data-tab="stories">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2V5Z"/><path d="M4 19v2M8 7h6"/></svg>
        <span>Stories</span>
      </button>
      <button type="button" data-tab="1929">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg>
        <span>1929</span>
      </button>
      <button type="button" data-tab="tours">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="18" r="2"/><circle cx="18" cy="6" r="2"/><path d="M8 18h6a4 4 0 0 0 0-8h-4a4 4 0 0 1 0-8h6"/></svg>
        <span>Tours</span>
      </button>
      <button type="button" data-tab="share">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
        <span>Share</span>
      </button>
    </nav>
  </div>

  <noscript>
    <div class="page-list">
      <h1>Stories from the Triangle</h1>
      <ul>{articles.map(a => <li><a href={`/stories/${slugs.get(Number(a.id))}/`}>{a.title}</a></li>)}</ul>
    </div>
  </noscript>

  <!-- CRITICAL: Scripts must load in this exact order -->
  <!-- 1. Leaflet core (everything else depends on this) -->
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha384-cxOPjt7s7Iz04uaHJceBmS+qpjv2JkIHNVcuOrM+YHwZOmJGBXI00mdUXEq65HTH" crossorigin="anonymous"></script>
  <!-- 2. Leaflet plugins (depend on Leaflet) -->
  <script is:inline src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"
    integrity="sha384-eXVCORTRlv4FUUgS/xmOyr66XBVraen8ATNLMESp92FKXLAMiKkerixTiBvXriZr" crossorigin="anonymous"></script>
  <!-- 3. Leaflet Routing Machine (depends on Leaflet) -->
  <script is:inline src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"
    integrity="sha384-Le/Ab4WG5Ezkdf4RS5P5eZrpmvNgcZ4QcTozVDXGoOsTxGroBLM4e9OSqeh6V26n" crossorigin="anonymous"></script>
  <!-- DOMPurify: sanitises story text before display -->
  <script is:inline src="https://unpkg.com/dompurify@3.4.18/dist/purify.min.js"
    integrity="sha384-lkArbWjiZKuE+bzKbj1vOEF7DKYBDNvgwZMCt5OH8bdRB92zpzyNska9Q/XKPHQD" crossorigin="anonymous"></script>
  <!-- 4. Your application code (depends on all of the above) -->
  <script is:inline type="module" src="/main.js"></script>
</body>
</html>
